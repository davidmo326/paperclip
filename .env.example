DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip
PORT=3100
SERVE_UI=false

# --- pacc (Personal AI Control Plane) plugin ---
# Briefer model wiring. Uses your Claude *subscription* via the local Claude
# Code CLI (OAuth login already on this machine) — NO API key, NO login
# details to add here. Just switch it on:
#   on / true / 1 / default  -> enabled with the default model (claude-sonnet-4-6)
#   <a model id>             -> enabled with that model (e.g. claude-opus-4-8)
#   unset / off              -> deterministic offline briefs
# PACC_BRIEFER_MODEL=on
# PACC_CLAUDE_BIN=claude                 # optional: path to the claude binary
# PACC_BRIEFER_MODEL_TIMEOUT_MS=120000   # optional: per-call timeout
